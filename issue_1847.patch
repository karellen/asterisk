From 9c4a88a2a6cd6c0127d9d3889792dfaa03d5d934 Mon Sep 17 00:00:00 2001
From: Arcadiy Ivanov <arcadiy@ivanov.biz>
Date: Tue, 31 Mar 2026 20:08:23 -0400
Subject: [PATCH] res_pjsip_sdp_rtp: Use auto-selected transport bind address
 for RTP

When a PJSIP endpoint does not explicitly set `transport`, the RTP
socket binds to [::] (or 0.0.0.0) instead of the transport's bind
address. This is because create_rtp() only resolves the transport
via a sorcery lookup on session->endpoint->transport, which is empty
when the transport is auto-selected.

On a host that also serves as a NAT gateway with iptables DNAT and
MASQUERADE, the wildcard-bound RTP socket causes the kernel to select
the WAN IP as the source address for outbound RTP. This creates a
conntrack tuple collision with inbound DNAT entries for the same port,
causing MASQUERADE to silently remap the RTP source port. The remote
end receives RTP from an unexpected port and drops it, resulting in
one-way audio with no errors logged by Asterisk.

When no explicit transport is configured, determine the transport type
from the dialog's target URI and query the transport manager for the
local bind address via pjsip_tpmgr_find_local_addr(). This is the
same mechanism used by sip_dialog_create_from() to resolve the local
address for the From header, and produces the correct bind address
regardless of whether the transport was explicitly configured or
auto-selected.

Fixes: #1847
---
 res/res_pjsip_sdp_rtp.c | 46 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/res/res_pjsip_sdp_rtp.c b/res/res_pjsip_sdp_rtp.c
index 7d2a5e7c4a..60bb1b43b5 100644
--- a/res/res_pjsip_sdp_rtp.c
+++ b/res/res_pjsip_sdp_rtp.c
@@ -264,6 +264,52 @@ static int create_rtp(struct ast_sip_session *session, struct ast_sip_session_me
 				ao2_ref(trans_state, -1);
 			}
 			ao2_ref(transport, -1);
+		} else if (session->inv_session && session->inv_session->dlg
+				&& (PJSIP_URI_SCHEME_IS_SIP(session->inv_session->dlg->target)
+					|| PJSIP_URI_SCHEME_IS_SIPS(session->inv_session->dlg->target))) {
+			/*
+			 * The endpoint does not have an explicit transport configured.
+			 * Ask the transport manager for the local address that would be
+			 * used for the dialog's target URI, so the RTP socket is not
+			 * left on the wildcard address. On a multi-homed or NAT-gateway
+			 * host a wildcard bind causes the kernel to choose a source IP
+			 * that conflicts with conntrack DNAT entries for inbound RTP.
+			 */
+			pjsip_sip_uri *sip_uri;
+			pjsip_transport_type_e type;
+			pj_str_t local_addr;
+			int local_port;
+
+			sip_uri = pjsip_uri_get_uri(session->inv_session->dlg->target);
+			type = pjsip_transport_get_type_from_name(&sip_uri->transport_param);
+			if (PJSIP_URI_SCHEME_IS_SIPS(sip_uri)) {
+				if (type == PJSIP_TRANSPORT_UNSPECIFIED
+						|| !(pjsip_transport_get_flag_from_type(type) & PJSIP_TRANSPORT_SECURE)) {
+					type = PJSIP_TRANSPORT_TLS;
+				}
+			} else if (!sip_uri->transport_param.slen) {
+				type = PJSIP_TRANSPORT_UDP;
+			}
+
+			if (pj_strchr(&sip_uri->host, ':')) {
+				type |= PJSIP_TRANSPORT_IPV6;
+			}
+
+			if (type != PJSIP_TRANSPORT_UNSPECIFIED
+					&& pjsip_tpmgr_find_local_addr(
+						pjsip_endpt_get_tpmgr(ast_sip_get_pjsip_endpoint()),
+						session->inv_session->dlg->pool, type,
+						&session->inv_session->dlg->tp_sel,
+						&local_addr, &local_port) == PJ_SUCCESS) {
+				char hoststr[PJ_INET6_ADDRSTRLEN];
+
+				ast_copy_pj_str(hoststr, &local_addr, sizeof(hoststr));
+				if (ast_sockaddr_parse(&temp_media_address, hoststr, 0)) {
+					ast_debug_rtp(1, "Transport manager bound to %s: Using it for RTP media.\n",
+						hoststr);
+					media_address = &temp_media_address;
+				}
+			}
 		}
 	}
 
-- 
